{
  "$schema": "https://aka.ms/terminal-profiles-schema",

  "alwaysShowTabs": true,
  "showTabsInTitlebar": true,
  "useAcrylicInTabRow": true,
  "copyFormatting": "none",
  "copyOnSelect": false,

  "profiles": {
    "defaults": {
      "font": {
        "face": "JetBrainsMono Nerd Font"
      },
      "opacity": 50,
      "useAcrylic": true,
      "colorScheme": "Catppuccin Mocha"
    },
    "list": []
  },

  "schemes": [
    {
      "name": "Catppuccin Mocha",
      "background": "#1E1E2E",
      "foreground": "#CDD6F4",
      "cursorColor": "#F5E0DC",
      "selectionBackground": "#585B70",
      "black": "#45475A",
      "red": "#F38BA8",
      "green": "#A6E3A1",
      "yellow": "#F9E2AF",
      "blue": "#89B4FA",
      "purple": "#F5C2E7",
      "cyan": "#94E2D5",
      "white": "#BAC2DE",
      "brightBlack": "#585B70",
      "brightRed": "#F38BA8",
      "brightGreen": "#A6E3A1",
      "brightYellow": "#F9E2AF",
      "brightBlue": "#89B4FA",
      "brightPurple": "#F5C2E7",
      "brightCyan": "#94E2D5",
      "brightWhite": "#A6ADC8"
    }
  ],

  "theme": "custom",

  "themes": [
    {
      "name": "custom",
      "tab": {
        "background": "#2b2138cc",
        "unfocusedBackground": "#15121ccc",
        "showCloseButton": "hover"
      },
      "tabRow": {
        "background": "#00000000",
        "unfocusedBackground": "#00000000"
      },
      "window": {
        "applicationTheme": "dark",
        "useMica": true
      }
    }
  ]
}
